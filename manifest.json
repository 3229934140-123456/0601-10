{
  "manifest_version": 3,
  "name": "AI 智能助手 - 客服运营内容编辑工具",
  "version": "1.0.0",
  "description": "为客服、运营和内容编辑人员打造的AI智能助手，提供文本改写、摘要、翻译、批处理等多功能",
  "default_locale": "zh_CN",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "tabs",
    "clipboardWrite",
    "clipboardRead",
    "sidePanel",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "AI 智能助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidebar/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "打开AI助手侧边栏"
    },
    "summarize-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "总结当前网页"
    }
  }
}
